# Copiá este archivo a ".env" (mismo nombre, sin ".example") antes de
# correr la app.

# Clave secreta para firmar las cookies de sesión. Poné cualquier texto
# largo y aleatorio, sobre todo antes de publicarla online.
SESSION_SECRET="cambiar-por-una-clave-larga-y-aleatoria"

# Emails que van a ser administradores automáticamente al registrarse,
# separados por coma.
ADMIN_EMAILS="fenzogustavo@gmail.com"

# Código de invitación inicial (el admin puede cambiarlo después desde
# Admin -> Jugadores).
INVITE_CODE_DEFAULT="VIERNES2026"

# Dónde guardar el archivo de base de datos SQLite. Por defecto se crea
# en esta misma carpeta.
DATABASE_PATH="futbolviernes.db"
